{
  "name": "tgd-pi-web",
  "private": true,
  "version": "2026.10.09-1",
  "description": "Web interface for Pi Coding Agent with tGD workflow integration",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=23.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhwangtw/tgd-pi-web.git"
  },
  "homepage": "https://github.com/yhwangtw/tgd-pi-web#readme",
  "bugs": {
    "url": "https://github.com/yhwangtw/tgd-pi-web/issues"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "preview": "node scripts/serve.mjs preview",
    "preview:configure": "node scripts/configure-preview-models.mjs",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs start",
    "scheduler:watch": "node scripts/schedule-watchdog.mjs",
    "lint": "eslint .",
    "postinstall": "node scripts/patch-pi-brace-expansion.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:capabilities": "node scripts/sync-capability-docs.mjs",
    "audit:js-budget": "node scripts/audit-js-budget.mjs",
    "docs:capabilities": "node scripts/sync-capability-docs.mjs --write",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "mermaid": {
      "dompurify": "3.4.16"
    },
    "jsdom": {
      "undici": "7.29.1"
    },
    "@earendil-works/pi-durable": {
      "@earendil-works/pi-ai": "1.0.0"
    },
    "next": {
      "postcss": "^8.5.18",
      "sharp": "0.35.5"
    },
    "source-map-js": "1.2.2",
    "colord": "2.10.0",
    "hono": "4.13.13",
    "ip-address": "10.7.3",
    "sprintf-js": "$sprintf-js",
    "katex": "$katex"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-ai-durable": "npm:@earendil-works/pi-ai@1.0.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@lobehub/icons": "^5.6.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "brace-expansion": "5.0.12",
    "diff": "8.0.4",
    "es-module-lexer": "2.1.0",
    "ignore": "7.0.5",
    "katex": "0.19.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.8",
    "parse5": "8.0.1",
    "postcss": "8.5.25",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typebox": "^1.1.38",
    "web-push": "^3.6.7",
    "sprintf-js": "file:vendor/sprintf-js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/bundle-analyzer": "^16.3.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^26.0.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
