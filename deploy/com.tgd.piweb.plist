<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS LaunchAgent. Install to ~/Library/LaunchAgents/com.tgd.piweb.plist
     then: launchctl load -w ~/Library/LaunchAgents/com.tgd.piweb.plist
     Runs at login and restarts on crash. Replace the two CHANGE_ME paths and
     confirm the node/npm path with `command -v npm` (Homebrew node is usually
     /opt/homebrew/bin on Apple Silicon, /usr/local/bin on Intel). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tgd.piweb</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/npm</string>
        <string>run</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME_USER/tGD-pi-web</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key><string>production</string>
        <key>PORT</key><string>30141</string>
        <key>HOSTNAME</key><string>0.0.0.0</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- For remote access, uncomment both and replace the values. Generate
             PIWEB_SESSION_SECRET once with: openssl rand -hex 32 -->
        <!-- <key>PIWEB_ACCESS_PASSWORD</key><string>change-me-to-a-long-passphrase</string> -->
        <!-- <key>PIWEB_SESSION_SECRET</key><string>change-me-to-a-random-64-character-value</string> -->
    </dict>

    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>

    <key>StandardOutPath</key><string>/tmp/piweb.log</string>
    <key>StandardErrorPath</key><string>/tmp/piweb.err.log</string>
</dict>
</plist>
