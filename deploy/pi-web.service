[Unit]
Description=tGD pi-web (pi coding-agent web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Fill these in ──────────────────────────────────────────────────────────
# The user pi-web runs as. IMPORTANT: this is a coding agent that can run bash
# and read/write files with THIS user's permissions — do not run it as root.
User=CHANGE_ME_USER

# Absolute path to the cloned repo (where package.json lives).
WorkingDirectory=/home/CHANGE_ME_USER/tGD-pi-web

# Start the already-built app. Run `npm run build` once before enabling this
# service (and after every `git pull`). `%h` expands to the user's home.
# If `npm` isn't on the service PATH, use an absolute path (run `command -v npm`).
ExecStart=/usr/bin/npm run start

# Bind to all interfaces so Tailscale / a tunnel can reach it. Next reads PORT.
Environment=NODE_ENV=production
Environment=PORT=30141
Environment=HOSTNAME=0.0.0.0

# STRONGLY recommended when reachable beyond localhost: require a login
# (see deploy/README.md §0). Uncomment and set a long passphrase.
# Environment=PIWEB_ACCESS_PASSWORD=change-me-to-a-long-passphrase
# Generate this once with `openssl rand -hex 32`; keep it stable across restarts.
# Environment=PIWEB_SESSION_SECRET=change-me-to-a-random-64-character-value

# Keep it up
Restart=on-failure
RestartSec=5

# ── Light hardening (optional but recommended) ─────────────────────────────
# The agent needs to read/write your project dirs, so DON'T lock the whole FS.
# These just trim obviously-unneeded privileges.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
